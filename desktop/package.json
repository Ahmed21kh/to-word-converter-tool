{
  "name": "pdf-to-word-desktop",
  "productName": "PDF to Word",
  "version": "1.0.0",
  "description": "Arabic-first PDF to Word converter - desktop app",
  "author": "Ahmed Khaled",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "sa.alasi.pdf-to-word",
    "productName": "PDF to Word",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!storage/**",
          "!test/**",
          "!scripts/**",
          "!.env",
          "!nodemon.json",
          "!README.md"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**",
          "!.cache/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "ai",
        "to": "ai"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PDF to Word",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
