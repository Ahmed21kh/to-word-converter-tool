{
  "name": "pdf-to-word-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first PDF to Word converter - React UI",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@fontsource/cairo": "^5.3.0",
    "antd": "^6.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
