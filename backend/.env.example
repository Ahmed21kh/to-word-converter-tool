# Copy to .env and run with:  node --env-file=.env src/server.js   (or export the variables)
PORT=4100
NODE_ENV=production

# Browser origins allowed to call the API (comma separated). Not needed when the frontend is served by this same server.
CORS_ORIGINS=http://localhost:5173

# Where uploads, results and previews are stored (deleted automatically)
DATA_DIR=./storage
MAX_UPLOAD_MB=500
RETENTION_MINUTES=60

# Performance: page workers (threads) and how many documents convert at the same time
WORKERS=4
MAX_CONCURRENT_JOBS=2
PAGE_TIMEOUT_MS=180000
RATE_LIMIT_PER_MINUTE=30
# Proxies in front of the API (a host's load balancer); default 1 in production. Raise it if all visitors share one rate limit.
# TRUST_PROXY=1

# Optional: enables .doc output and Office/RTF input
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Optional: folder with the built frontend (default ../frontend/dist)
# FRONTEND_DIST=../frontend/dist
LOG_LEVEL=info

# ---- Optional: "AI reading" for scanned pages (much more accurate than the free OCR on diacritised books) ----
# claude : Anthropic API through the official SDK. Needs ANTHROPIC_API_KEY. Page images are sent to Anthropic and billed per use.
# gemini : Google Gemini API through the official @google/genai SDK. Needs GEMINI_API_KEY. Page images are sent to Google.
# ollama : a local vision model served by Ollama (free, nothing leaves your machine).
# Leave VISION_PROVIDER empty to keep AI reading disabled (the UI then disables the option).
# VISION_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5-5          # cheaper: claude-sonnet-5-5 (about half) or claude-haiku-5-5 (much cheaper, less accurate)
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest      # or a fixed version such as gemini-3.8-flash (gemini-2.5-flash is closed to new keys)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used when GEMINI_MODEL's quota is used up (free tier: 20 requests/day)
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH    # page images: HIGH (~1120 tokens, default) or MEDIUM (~560: cheaper, compare on your books first)
# GEMINI_EXEMPLAR=./exemplar/page.jpg            # optional worked example (page.jpg + its checked transcription page.txt), context-cached once per book
# GEMINI_BATCH_POLL_MS=30000                     # how often an "economy reading" job asks Google whether its batch is done
# Readers tried when the first one declines a page (Gemini recitation stop) or fails, before the standard OCR: claude, llamacpp (comma separated)
# VISION_FALLBACK=claude
# VISION_FALLBACK_MODEL=claude-haiku-5-5         # model of the claude fallback (needs ANTHROPIC_API_KEY)
# VISION_BAND_LINES=8                            # text lines per band when a held-back page is read again in pieces
# Local AI switch: LOCAL_AI=1 uses the local reader below (LOCAL_AI_PROVIDER, default llamacpp) and turns the cloud provider off
# LOCAL_AI=0
# LOCAL_AI_PROVIDER=llamacpp
# VISION_PROVIDER=llamacpp            # local Qari-OCR (recommended for free local use): run scriptsstart-qari.ps1 -Download once, then scriptsstart-qari.ps1
# LLAMA_URL=http://127.0.0.1:8081
# QARI_DIR=E:/ollama/qari            # folder with model.gguf and mmproj.gguf; the API starts the Qari server itself
# LLAMA_SERVER_EXE=                    # only if llama-server is not found next to Ollama on the PATH
# LLAMA_PARALLEL=3                     # text lines read at once
# VISION_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# VISION_MODEL=qwen2.5vl:7b

# Public https address of the site: enables the optional "Word view (Microsoft)" tab in the preview (read-only; sends the file to Microsoft)
# PUBLIC_URL=https://pdf.example.com
